# Copy this file to .env and fill in your own values. Never upload .env to GitHub.

# PostgreSQL connection (create the "ticketflow" database first)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ticketflow

# Long random string used to sign login tokens
SECRET_KEY=replace-this-with-your-own-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# How long a reserved ticket/seat is held before it is released
RESERVATION_MINUTES=10

# If true, new events start as "pending" until an admin approves them
REQUIRE_EVENT_APPROVAL=false

# Rate limiting for buying tickets (requests per window, per IP)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Email (optional). If SMTP_HOST is empty, emails are only logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=tickets@ticketflow.local
